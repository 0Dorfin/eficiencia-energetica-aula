# Copia este fichero a .env y ajusta los valores.
# .env esta ignorado por git: nunca subas credenciales al repositorio.

# --- TimescaleDB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=postgres

# Puerto del stack historico (docker-compose.yml)
POSTGRES_PORT=5432
# Puerto del stack en tiempo real (docker-compose.live.yml)
POSTGRES_LIVE_PORT=5433

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GRAFANA_LIVE_PORT=3001
