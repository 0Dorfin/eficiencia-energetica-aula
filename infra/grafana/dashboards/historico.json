        "rawSql": "SELECT \"time\", state_numeric AS \"value\" FROM silver_sensores WHERE entity_id = 'sensor.sensor_temperatura_3_temperature' AND state_numeric IS NOT NULL AND $__timeFilter(\"time\") ORDER BY \"time\"",
