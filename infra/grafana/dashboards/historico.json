    {
      "id": 5,
      "type": "gauge",
      "title": "T. Exterior",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 7 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ds" },
      "targets": [{
        "rawSql": "SELECT \"time\", state_numeric AS \"value\" FROM silver_sensores WHERE entity_id = 'sensor.mislata_temperatura' AND state_numeric IS NOT NULL AND $__timeFilter(\"time\") ORDER BY \"time\"",
        "format": "time_series",
        "refId": "A",
        "editorMode": "code"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": -5, "max": 42,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 10 },
              { "color": "orange", "value": 30 },
              { "color": "red",    "value": 36 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
