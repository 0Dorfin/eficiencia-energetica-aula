{
  "uid": "eficiencia-energetica",
  "title": "Eficiencia Energetica - Hoy en Directo",
  "tags": ["domotica", "eficiencia"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now/d", "to": "now" },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "T. Aula 1",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 7 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ds" },
      "targets": [{
        "rawSql": "SELECT \"time\", state_numeric AS \"value\" FROM silver_sensores WHERE entity_id = 'sensor.sensor_temperatura_1_temperature' AND state_numeric IS NOT NULL AND $__timeFilter(\"time\") ORDER BY \"time\"",
        "format": "time_series",
        "refId": "A",
        "editorMode": "code"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 15, "max": 35,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 18 },
              { "color": "yellow", "value": 24 },
              { "color": "red",    "value": 28 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
