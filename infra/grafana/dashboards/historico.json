    {
      "id": 6,
      "type": "gauge",
      "title": "Humedad Ext.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 7 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ds" },
      "targets": [{
        "rawSql": "SELECT \"time\", state_numeric AS \"value\" FROM silver_sensores WHERE entity_id = 'sensor.mislata_humedad' AND state_numeric IS NOT NULL AND $__timeFilter(\"time\") ORDER BY \"time\"",
        "format": "time_series",
        "refId": "A",
        "editorMode": "code"
      }],
