      "id": 4,
      "type": "gauge",
      "title": "T. Aula 4",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 7 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ds" },
      "targets": [{
        "rawSql": "SELECT \"time\", state_numeric AS \"value\" FROM silver_sensores WHERE entity_id = 'sensor.sensor_temperatura_4_temperature' AND state_numeric IS NOT NULL AND $__timeFilter(\"time\") ORDER BY \"time\"",
        "format": "time_series",
